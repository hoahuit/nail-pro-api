generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      String   @default("CUSTOMER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@map("users")
}

model LoyaltyAccount {
  id            String         @id @default(cuid())
  phone         String         @unique
  customerName  String?
  totalPoints   Int            @default(0)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  history       PointHistory[]

  @@map("loyalty_accounts")
}

model LoyaltyProgramConfig {
  id            String             @id @default(cuid())
  code          String             @unique @default("DEFAULT")
  pointsPerVisit Int               @default(1)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  rewardRules   LoyaltyRewardRule[]

  @@map("loyalty_program_configs")
}

model LoyaltyRewardRule {
  id              String               @id @default(cuid())
  programId       String
  thresholdPoints Int
  rewardType      String               // "FIXED" | "PERCENT"
  rewardValue     Decimal              @db.Decimal(10, 2)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  program         LoyaltyProgramConfig @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, thresholdPoints])
  @@index([programId, thresholdPoints])
  @@map("loyalty_reward_rules")
}

model PointHistory {
  id               String         @id @default(cuid())
  loyaltyAccountId String
  points           Int
  type             String         // "EARN" | "ADJUST"
  amountSpent      Decimal?       @db.Decimal(10, 2)
  staffName        String?
  note             String?
  addedByAdminId   String?
  createdAt        DateTime       @default(now())

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id])

  @@map("point_history")
}

model Voucher {
  id            String    @id @default(cuid())
  code          String    @unique
  type          String    // "PERCENT" | "FIXED"
  value         Decimal   @db.Decimal(10, 2)
  minOrderValue Decimal?  @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings Booking[]

  @@map("vouchers")
}


model Staff {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  bio       String?
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings  Booking[]

  @@map("staff")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  image       String?
  duration    Int
  price       Decimal  @db.Decimal(10, 2)
  category    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings    Booking[]

  @@map("services")
}
model Booking {
  id             String        @id @default(cuid())

  userId         String?
  customerName   String
  customerPhone  String
  customerEmail  String?

  serviceId      String
  staffId        String?

  startTime      DateTime
  endTime        DateTime

  duration       Int
  totalPrice     Decimal       @db.Decimal(10, 2)
  discountAmount Decimal?      @db.Decimal(10, 2)
  finalPrice     Decimal?      @db.Decimal(10, 2)

  voucherId      String?

  status         String        @default("PENDING")
  notes          String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User?    @relation(fields: [userId], references: [id])
  service        Service  @relation(fields: [serviceId], references: [id])
  staff          Staff?   @relation(fields: [staffId], references: [id])
  voucher        Voucher? @relation(fields: [voucherId], references: [id])

  @@index([staffId, startTime, endTime])
  @@map("bookings")
}

model SalonDayOff {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("salon_day_offs")
}

